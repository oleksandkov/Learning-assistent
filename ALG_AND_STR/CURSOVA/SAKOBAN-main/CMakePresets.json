{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-ninja-release",
      "displayName": "Windows Ninja Release",
      "description": "Release build with Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-ninja-debug",
      "displayName": "Windows Ninja Debug",
      "description": "Debug build with Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "windows-ninja-release"
    },
    {
      "name": "debug",
      "configurePreset": "windows-ninja-debug"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "windows-ninja-release"
    },
    {
      "name": "debug",
      "configurePreset": "windows-ninja-debug"
    }
  ]
}
