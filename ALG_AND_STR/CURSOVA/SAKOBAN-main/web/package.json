{
  "name": "sokoban-web",
  "version": "1.0.0",
  "private": true,
  "description": "Sokoban web version (Next.js) — thin UI over the shared C++20 core. See ../bindings/web for the WASM/API bridge.",
  "scripts": {
    "native": "node scripts/build-native.mjs",
    "predev": "npm run native",
    "prebuild": "npm run native",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:native": "npm run native && node --test tests/native.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "20.14.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "typescript": "5.5.3"
  },
  "engines": {
    "node": ">=18.17"
  }
}
